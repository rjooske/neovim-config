snippet fn
	fn ${1:name}(${2}) -> ${3} {
	    ${0}
	}

snippet marm
	${1} => ${0},

snippet marmb
	${1} => {
	    ${0}
	},

snippet skt
	#[derive(Debug, ${2})]
	struct ${1:Name} {
		${0}
	}

snippet enu
	#[derive(Debug, ${2})]
	enum ${1:Name} {
		${0}
	}

snippet testmod
	#[cfg(test)]
	mod ${1:tests} {
		use super::*;

		#[test]
		fn ${2:test}() {
			${0}
		}
	}

snippet testfn
	#[test]
	fn ${1:test}() {
		${0}
	}
