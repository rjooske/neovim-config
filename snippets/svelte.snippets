snippet if
	if (${1}) {
	  ${0}
	}

snippet elif
	else if (${1}) {
	  ${0}
	}

snippet else
	else (${1}) {
	  ${0}
	}

snippet fori
	for (let ${1:i} = ${2:0}; ${1} < ${3:n}; ${1}++) {
	  ${0}
	}

snippet forof
	for (const ${1:element} of ${2:list}) {
	  ${0}
	}

snippet func
	function ${1:name}(${2}): ${3} {
	  ${0}
	}

snippet clg
	console.log(${1})${0}

snippet cld
	console.dir(${1})${0}
