snippet if
	if ${1} {
		${0}
	}

snippet iferr
	if err != nil {
		return fmt.Errorf("${1}: %w", err)
	}

snippet for
	for ${1} {
		${0}
	}

snippet fori
	for ${1:i} := 0; ${1} < ${2:n}; ${1}++ {
		${0}
	}

snippet fn
	func ${1:name}(${2}) ${3} {
		${0}
	}

snippet meth
	func (${1}) ${2:name}(${3}) ${4} {
		${0}
	}

snippet skt
	type ${1} struct {
		${0}
	}
