snippet cn
	const ${1:name} = ${0}

snippet if
	if (${1}) {
	  ${0}
	}

snippet elif
	else if (${1}) {
	  ${0}
	}

snippet else
	else {
	  ${0}
	}

snippet swi
	switch (${1}) {
	  case ${2}:
	    ${0}
	}

snippet case
	case ${1}:
	  ${0}

snippet fori
	for (let ${1:i} = ${2:0}; ${1} < ${3:n}; ${1}++) {
	  ${0}
	}

snippet forof
	for (const ${1:e} of ${2:list}) {
	  ${0}
	}

snippet forin
	for (const ${1:e} in ${2:list}) {
	  ${0}
	}

snippet while
	while (${1}) {
	  ${0}
	}

snippet lam
	(${1}) => ${0}

snippet lamb
	(${1}) => {
	  ${0}
	}

snippet alam
	async (${1}) => ${0}

snippet alamb
	async (${1}) => {
	  ${0}
	}

snippet doc
	/**
	 * ${0}
	 */

snippet clg
	console.log(${1})${0}

snippet cld
	console.dir(${1})${0}

snippet constructor
	constructor(${1}) {
	  ${0}
	}
